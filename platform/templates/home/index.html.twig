{% extends 'base.html.twig' %}
{% block body %}
<section>
    <p class="text-cyan-300">Modular AI-powered ERP</p>
    <h1 class="mt-4 text-5xl font-bold">NXDOne</h1>
    <p class="mt-4 max-w-3xl text-xl text-slate-300">
        A modular ERP base for tax, sales, inventory, logistics, daily reporting, industry intelligence, and specialised AI workers.
    </p>
    <div class="mt-8 flex gap-4">
        <a href="{{ path('app_modules_install_defaults') }}" class="rounded bg-cyan-400 px-5 py-3 font-semibold text-slate-950">Install default modules</a>
        <a href="{{ path('app_modules') }}" class="rounded border border-slate-700 px-5 py-3 font-semibold">View modules</a>
    </div>
</section>

<section class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
        <h2 class="font-bold">Modules</h2>
        <p class="mt-2 text-3xl">{{ modules|length }}</p>
    </div>
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
        <h2 class="font-bold">Recent Jobs</h2>
        <p class="mt-2 text-3xl">{{ jobs|length }}</p>
    </div>
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6">
        <h2 class="font-bold">Architecture</h2>
        <p class="mt-2 text-slate-300">Symfony core + specialised Python workers</p>
    </div>
</section>

<section class="mt-10 rounded-2xl border border-slate-800 bg-slate-900 p-6">
    <h2 class="text-xl font-bold">Next modules</h2>
    <p class="mt-3 text-slate-300">We will add modules one at a time: Sales first, then Inventory, Logistics, Daily Reports, Industry News, and NXDTax integration.</p>
</section>
{% endblock %}